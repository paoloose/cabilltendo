[Unit]
Description=Cavilltendo Launcher
After=multi-user.target

[Service]
Type=simple
User={{USER_NAME}}
Environment=HOME=/home/{{USER_NAME}}
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
ExecStartPre=-/bin/sh -c 'echo -ne "\033c" > /dev/tty1'
ExecStartPre=+-/bin/rm -f /tmp/.X0-lock
ExecStart=/usr/bin/startx {{SCRIPTS_DIR}}/run_launcher.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
